# 環境變數範本：複製成 .env 後填入實際值。
# .env 已被 .gitignore 排除，絕不可提交；本檔只列變數名稱，不含任何實際值。

# 執行環境（必填）：development、testing、staging、production 擇一。
APP_ENV=

# 工作階段簽章金鑰（staging 與 production 必填；development 缺漏時使用臨時金鑰）。
SECRET_KEY=

# 資料庫連線字串（development、staging、production 必填）。
# SQL Server 範例：
#   mssql+pyodbc://<user>:<password>@<host>/<database>?driver=ODBC+Driver+18+for+SQL+Server
# 只有本機開發可以加上 &TrustServerCertificate=yes；staging 與 production 嚴禁，且不得使用 sa 帳號。
DATABASE_URL=

# 日誌層級（選填）：DEBUG、INFO、WARNING、ERROR、CRITICAL；預設 INFO。
LOG_LEVEL=

# 本機除錯模式（選填）；staging 與 production 不得開啟。
FLASK_DEBUG=

# SQL Server 整合測試用連線字串（選填）。
# 必須指向獨立的 project_test 資料庫，絕不可指向開發用的 project。
TEST_SQLSERVER_URL=

# ---- 會員驗證 -----------------------------------------------------------------

# 簽章金鑰輪替期間仍可驗證的舊金鑰（選填，以逗號分隔）。新簽發的內容一律使用 SECRET_KEY。
SECRET_KEY_FALLBACKS=

# 是否啟用信箱驗證與忘記密碼（true 或 false）。
# 未設定時：development、testing 為 false；staging、production 為 true。
# production 不得設為 false。本機建議明確寫 false（註冊後直接啟用，不寄信）。
EMAIL_VERIFICATION_REQUIRED=

# 對外網址（不含路徑），用於信件連結與 Google 登入回呼，不使用請求的主機標頭。
# 信箱驗證開啟或 Google 登入啟用時必填；staging 與 production 必須是 https。
# 本機範例：http://localhost:5000（瀏覽器請一律使用這個主機名稱，不要改用 127.0.0.1）。
BASE_URL=

# 寄信（SMTP）。信箱驗證開啟時，主機、連接埠與寄件者必填。
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
# 寄信連線方式：starttls（預設）、ssl、none；none 只允許 development 與 testing。
MAIL_SMTP_SECURITY=
# 寄信帳號與密碼須同時設定或同時省略。
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# 寄件者地址（單純的電子郵件地址）。
MAIL_FROM=

# ---- 營運告警（ops-alerting）-------------------------------------------------

# 告警信的收件人：逗號分隔的電子郵件地址，至多 5 個（去除空白與重複）。staging 與 production 必填；
# development 與 testing 可省略（此時 flask check-alerts 只評估並顯示結果，不寄信也不改變狀態）。
# 設定後，寄信設定（MAIL_SMTP_HOST、MAIL_SMTP_PORT、MAIL_FROM）也必須完整，即使信箱驗證是關閉的。
ALERT_EMAIL_TO=

# ---- 客服與模型呼叫（Gemini）-------------------------------------------------

# Gemini API 金鑰（staging 與 production 必填；development 缺漏時客服功能不可用並回應 503）。
# 只能放在這裡或平台的機密功能，絕不可貼到對話、程式碼或版本庫。
GEMINI_API_KEY=
# 模型名稱（選填；只允許英文字母、數字、點、底線與連字號）。
# 未設定時：主要 gemini-3.8-flash、備援 gemini-3.5-flash-lite、摘要與主要模型相同。
# 免費層對 gemini-3.8-flash 的限制很低（每分鐘約 5 次、每日約 20 次，以 AI Studio 顯示的額度為準），
# 過渡期（正式供應商確定之前）本機開發與驗收環境一律把 GEMINI_MODEL 設成 gemini-3.5-flash-lite（每日額度高很多，
# 不會因次數用完而被拒絕）；摘要模型未設定時與主要模型相同，所以也是它。
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_SUMMARY_MODEL=
# 單次呼叫逾時（預設 20 秒）、單次請求總預算（預設 30 秒，必須小於 55）、主要模型異常後暫時跳過它的秒數（預設 60）。
# 前端的請求逾時由伺服器自動設為「總預算加 5 秒」，不需要另外設定。
LLM_CALL_TIMEOUT_SECONDS=
LLM_REQUEST_BUDGET_SECONDS=
LLM_BREAKER_SECONDS=
# 單次輸出的 token 上限（含思考 token；預設 4096，範圍 256 至 32768）與選用的思考預算（0 或正整數；不設定則使用供應商預設）。
LLM_MAX_OUTPUT_TOKENS=
GEMINI_THINKING_BUDGET=

# 全站每日用量上限（選填；以台灣時間 00:00 為日界，從 llm_call_logs 彙總全部模型呼叫，含摘要與失敗的嘗試）。
# 任一項達 80% 記錄警告事件，任一項達 100% 即停止呼叫模型並回覆「目前使用人數較多，請稍後再試。」。
# 預設值依 gemini-3.5-flash-lite 免費層（15 RPM、25 萬 TPM、每日 500 次請求）：呼叫次數 450（500 的 90%）、token 1000000。
# 每次請求不論大小都耗用每日請求數，單靠 token 上限擋不住它，所以兩者並用。換模型或換供應商時必須依新方案重設。
USAGE_DAILY_TOKEN_LIMIT=
USAGE_DAILY_CALL_LIMIT=

# ---- RPG 敘事用途的 OpenAI 相容端點（目前是 OpenRouter）----------------------------
# 客服與摘要永遠使用 Gemini；這一組只給 RPG 敘事。金鑰與主要模型須同時設定或同時省略（都不設定 = RPG 用途不可用）。
# 金鑰只能放在這裡或平台的機密功能，絕不可貼到對話、程式碼或版本庫。
OPENROUTER_API_KEY=
# 模型識別碼（只允許英文字母、數字、點、底線、連字號、斜線與冒號，最長 64 字，與帳本的模型欄位一致）。
# 先用免費模型（識別碼以 :free 結尾）確認好不好用；確定後換成付費模型，只需要改這個值，程式不用動。
# 免費端點的上游可能保存或拿去訓練提示，測試請只用無害的合成文字，也不要輸入真實個資。
OPENROUTER_MODEL=
# 備援模型（選填，格式同上）；未設定時等於主要模型（暫時性錯誤直接降級）。
OPENROUTER_FALLBACK_MODEL=
# 基底網址（選填；預設為 OpenRouter 官方網址）。必須是 https；development 與 testing 另允許回送位址的 http（本機模型），
# 不得含帳號、密碼或查詢字串。金鑰會隨請求送往這個網址。
OPENROUTER_BASE_URL=
# 是否要求只路由到不保存提示的端點（true 或 false；預設 false）。付費模型才有這類端點，免費端點通常沒有，
# 要求了卻沒有符合的端點時呼叫會失敗，不會改成不帶偏好重送。
OPENROUTER_ZDR=
# 該模型是否支援結構描述輸出參數（true 或 false；預設 false，改在系統指令附結構描述）。
OPENROUTER_JSON_SCHEMA=

# ---- 內容分級（AGENTS.md 第 7 節）---------------------------------------------
# 是否開啟 sexual_content_level 3（true 或 false；預設 false）。只能以環境設定開啟，不得寫死。
# development 與 testing 可開啟；staging 與 production 在強化的成年驗證完成之前設為 true 會啟動失敗。
# 開啟時，RPG 用途必須已設定，且 SEXUAL_CONTENT_LEVEL3_MODELS 必須涵蓋 OPENROUTER_MODEL 與 OPENROUTER_FALLBACK_MODEL。
SEXUAL_CONTENT_LEVEL3_ENABLED=
# 取得書面許可所涵蓋的模型識別碼（以逗號分隔；免費與付費的識別碼各自列出）。許可涵蓋的供應商與日期須另外記錄。
SEXUAL_CONTENT_LEVEL3_MODELS=

# Google 登入（選填）。用戶端識別碼與密鑰須同時設定才會啟用；開發與正式環境請用不同的 OAuth 用戶端。
# 授權的重新導向 URI 為 <BASE_URL>/auth/google/callback。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
